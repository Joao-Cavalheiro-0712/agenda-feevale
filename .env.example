# ---- Copie para .env (local) ou defina no Railway → Variables ----

APP_ENV=development           # development | staging | production
APP_NAME=Planno
PUBLIC_URL=                   # ex.: https://planno.up.railway.app
SECRET_KEY=troque-por-um-valor-aleatorio-longo

# --- Banco (Railway injeta DATABASE_URL ao adicionar Postgres) ---
# DATABASE_URL=postgresql://user:pass@host:5432/db

# --- IA (opcional: sem chave, o app usa o interpretador heurístico) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL_FAST=gemini-2.5-flash
AI_MODEL_STRONG=gemini-2.5-pro
AI_MODEL_VISION=gemini-2.5-flash

# --- WhatsApp Cloud API ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=agenda-verify
WHATSAPP_APP_SECRET=
WHATSAPP_NUMBER=+5551999999999

# --- Telegram (canal alternativo, opcional) ---
TELEGRAM_BOT_TOKEN=

# --- Fuso e lembretes ---
TIMEZONE=America/Sao_Paulo
REMINDER_DAYS=7,1
REMINDER_HOUR=8

# --- Uploads e retenção ---
MAX_UPLOAD_MB=25
AUDIO_RETENTION_DAYS=7
DOCUMENT_RETENTION_DAYS=0     # 0 = manter até o usuário apagar

# --- Feature flags ---
FEATURE_WHATSAPP=true
FEATURE_DOCUMENT_IMPORT=true
FEATURE_AUTO_CREATE=true
FEATURE_SHARING=true
FEATURE_FAMILY=false
FEATURE_STUDY_PLANNER=false

ADMIN_EMAILS=
