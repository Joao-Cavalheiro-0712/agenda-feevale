# ---- Copie para .env (local) ou defina no Railway → Variables ----

# Telegram (obrigatório) — token do bot criado com o @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Opcional: seu chat_id fixo (se não souber, mande /start pro bot)
TELEGRAM_CHAT_ID=

# Google Gemini (recomendado) — extração inteligente dos cronogramas
# Gere em https://aistudio.google.com/app/apikey  (Gemini Flash é barato)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Banco de dados — no Railway, adicione um Postgres e ele injeta DATABASE_URL.
# Sem isso, usa SQLite local (agenda.db).
# DATABASE_URL=postgresql://user:pass@host:5432/db

# Fuso e horário do lembrete diário
TIMEZONE=America/Sao_Paulo
DAILY_HOUR=8
DAILY_MINUTE=0

# Quantos dias antes avisar (1 semana e 1 dia antes)
REMINDER_DAYS=7,1

# Senha opcional para proteger a interface web
WEB_PASSWORD=
