# ---- Copie para .env (local) ou defina no Railway → Variables ----

APP_ENV=development           # development | staging | production
APP_NAME=Grifo
PUBLIC_URL=                   # ex.: https://planno.up.railway.app
SECRET_KEY=troque-por-um-valor-aleatorio-longo

# --- Banco (Railway injeta DATABASE_URL ao adicionar Postgres) ---
# DATABASE_URL=postgresql://user:pass@host:5432/db

# --- IA (opcional: sem chave, o app usa o interpretador heurístico) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL_FAST=gemini-2.5-flash
AI_MODEL_STRONG=gemini-2.5-pro
AI_MODEL_VISION=gemini-2.5-flash

# --- WhatsApp Cloud API ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=agenda-verify
WHATSAPP_APP_SECRET=
WHATSAPP_NUMBER=+5551999999999

# --- Telegram (canal alternativo, opcional) ---
TELEGRAM_BOT_TOKEN=

# --- Fuso e lembretes ---
TIMEZONE=America/Sao_Paulo
REMINDER_DAYS=7,1
REMINDER_HOUR=8

# --- Uploads e retenção ---
MAX_UPLOAD_MB=25
AUDIO_RETENTION_DAYS=7
DOCUMENT_RETENTION_DAYS=0     # 0 = manter até o usuário apagar

# --- Feature flags ---
FEATURE_WHATSAPP=true
FEATURE_DOCUMENT_IMPORT=true
FEATURE_AUTO_CREATE=true
FEATURE_SHARING=true
FEATURE_FAMILY=false
FEATURE_STUDY_PLANNER=false

# --- Web Push (gere com: python -m agenda.cli vapid) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=suporte@exemplo.com

# --- Limites de processamento ---
MAX_DOCUMENT_PAGES=80
MAX_DOCUMENT_CHARS=400000

FEATURE_BILLING=false
ADMIN_EMAILS=

# --- E-mail (confirmação e recuperação de senha) ---
# Sem SMTP, o link sai no log do servidor em vez da caixa de entrada: em
# desenvolvimento isso é conveniente, em produção é um aviso ruidoso de que a
# recuperação de conta não está funcionando.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_VERIFY_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=30

# --- Entrar com Google e com Apple ---
# O redirect_uri a registrar no provedor é
#   https://<domínio>/entrar/<google|apple>/retorno
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID é o Services ID, não o bundle do app. A Apple não dá um
# segredo: a gente assina um JWT ES256 com a chave .p8 (com \n escapado).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Chaves de acesso (Face ID, digital, Windows Hello) ---
# Domínio registrável, sem esquema e sem porta. Errar isto é o motivo número
# um de "funciona local e quebra em produção". Vazio deriva de PUBLIC_URL.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# --- Armazenamento e backup ---
# ATENÇÃO: os dois precisam apontar para um VOLUME PERSISTENTE. No disco do
# contêiner, os arquivos enviados e os backups somem a cada deploy.
STORAGE_DIR=
BACKUP_DIR=
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
